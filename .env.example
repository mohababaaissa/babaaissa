# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION — AUTO-ÉCOLE BABAAISSA (Bouarfa, Maroc)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Secret (Used for signing sessions and tokens)
AUTH_SECRET=your_super_secret_jwt_key_min_32_characters_long_for_babaaissa

# Optional: Supabase PostgreSQL Integration
# If deploying to Supabase, run `supabase_schema.sql` in your Supabase SQL Editor
# and configure the following variables:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-never-expose-to-client

# Official Driving School Details (Verified)
NEXT_PUBLIC_SCHOOL_NAME="Auto-école Babaaissa"
NEXT_PUBLIC_SCHOOL_NAME_AR="مدرسة تعليم السياقة باباعيسى"
NEXT_PUBLIC_CITY="Bouarfa"
NEXT_PUBLIC_ADDRESS="Hay Al Wahda N°1, Bouarfa"
NEXT_PUBLIC_PHONE="0626783160"
NEXT_PUBLIC_WHATSAPP="212626783160"
